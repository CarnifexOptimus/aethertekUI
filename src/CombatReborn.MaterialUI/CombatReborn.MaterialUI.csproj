<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Compact MD3-inspired immediate-mode controls for Dalamud.</Description>
    <PackageId>CombatReborn.MaterialUI</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/"/>
    <Reference Include="Dalamud.Bindings.ImGui"><HintPath>$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireDalamud" BeforeTargets="ResolveReferences" Condition="!Exists('$(DalamudLibPath)/Dalamud.Bindings.ImGui.dll')">
    <Error Text="Set DalamudLibPath to the installed API 15 distribution (dot-source eng/Enter-RepoEnv.ps1)."/>
  </Target>
</Project>
